{
  "name": "api_minhasfinancas",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply minhas_financas --local",
    "db:migrate:remote": "wrangler d1 migrations apply minhas_financas --remote",
    "db:studio": "drizzle-kit studio",
    "db:seed": "wrangler d1 execute minhas_financas --local --file=./src/database/seed.sql",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.27",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@paralleldrive/cuid2": "^3.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.4.0"
  }
}