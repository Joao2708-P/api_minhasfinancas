{
    "name": "minhas-financas-api",
    "main": "src/index.ts",
    "compatibility_date": "2026-07-10",
    "vars": {
        "CORS_ORIGINS": "https://minhas-financas-app.pages.dev",
        "EMAIL_FROM": "Metria Finanças <onboarding@resend.dev>",
        "COOKIE_SAMESITE": "None"
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "minhas_financas",
            "database_id": "14aa83ed-b444-47d8-9bcf-44213b0918be",
            "migrations_dir": "./migrations"
        }
    ],
    "r2_buckets": [
        {
            "binding": "BUCKET",
            "bucket_name": "minhas-financas-extratos"
        }
    ],
    "ratelimits": [
        {
            "name": "RL_LOGIN",
            "namespace_id": "1001",
            "simple": { "limit": 8, "period": 60 }
        },
        {
            "name": "RL_CODE",
            "namespace_id": "1002",
            "simple": { "limit": 8, "period": 60 }
        }
    ]
}
